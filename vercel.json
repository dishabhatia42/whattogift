{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/refresh-catalog",
      "schedule": "30 21 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/h/:id",
      "destination": "/api/hint?id=:id"
    }
  ]
}
